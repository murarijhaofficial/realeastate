{
  "name": "estatedesk-workspace",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @estatedesk/backend --filter @estatedesk/frontend dev",
    "dev:backend": "pnpm --filter @estatedesk/backend dev",
    "dev:frontend": "pnpm --filter @estatedesk/frontend dev",
    "build": "pnpm --filter @estatedesk/frontend build",
    "start": "pnpm --filter @estatedesk/backend start",
    "test": "pnpm --filter @estatedesk/backend test && pnpm --filter @estatedesk/frontend test",
    "db:migrate": "pnpm --filter @estatedesk/backend db:migrate",
    "db:seed": "pnpm --filter @estatedesk/backend db:seed",
    "db:seed:demo": "pnpm --filter @estatedesk/backend db:seed:demo"
  }
}
